              "radiusM": 40,
              "factIfPerceivedBy": {
                "hero": "heardShout"
              }
            }
          ],
          "exits": [
            {
              "to": "idle",
              "kind": "hazard",
              "perMille": 500
            }
          ]
        },
        "chosen": {
          "onEnter": [
            {
              "flag": "busy",
