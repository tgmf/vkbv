              "ttl": 10
            },
            {
              "gauge": "@boss.boxPull",
              "add": 50,
              "holdTicks": 5
            },
            {
              "interrupt": [
                "@boss",
                "stretch",
                2
              ]
            }
          ],
          "exits": [
            {
              "to": "idle",
              "kind": "auto",
              "gate": {
                "not": {
                  "flag": "busy",
                  "at": "@boss"
                }
              }
            }
          ]
        },
        "done": {
          "textKey": "sl.shift.done",
          "onEnter": [
            {
              "stop": "@boss"
            },
            {
              "fact": "gateClosed"
            },
            {
              "trigger": "rite"
            }
          ],
          "exits": []
        }
