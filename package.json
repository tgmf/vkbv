{
  "name": "vkbv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsx scripts/size.ts",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:check",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "content:check": "tsx scripts/content.ts",
    "sim": "tsx src/cli/sim.ts",
    "balance": "tsx scripts/not-yet.ts balance M4",
    "calibrate": "tsx scripts/calibrate.ts",
    "vet": "tsx scripts/vet.ts",
    "golden:update": "vitest run tests/golden --update",
    "gen:exp-table": "tsx scripts/gen-exp-table.ts",
    "gen:phi-table": "tsx scripts/gen-phi-table.ts"
  },
  "dependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "0.20.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
