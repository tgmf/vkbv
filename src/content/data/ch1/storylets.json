                { "gauge": "@marti.fearOfWater", "per": 300, "add": 1, "if": { "weather": "rain" }, "note": "the awning by the steps is the nearest roof" }
              ] } },
            { "to": "detour_square", "kind": "choice", "actor": "@marti",
              "score": { "base": -2, "terms": [
                { "gauge": "@marti.teaCraving", "per": 200, "add": 1 },
                { "gauge": "@marti.fearOfWater", "per": 250, "add": -1, "if": { "weather": "rain" } }
              ] } },
            { "to": "turn_home", "kind": "choice", "actor": "@marti",
              "score": { "base": -1, "terms": [
                { "gauge": "@marti.fearOfWater", "per": 250, "add": 1 },
                { "if": { "gauge": "@marti.questionItch", "lt": 400 }, "add": 1 }
              ] } }
          ]
        },
        "toward_steps": {
          "textKey": "sl.blocked_road.toward_steps",
          "onEnter": [{ "fact": "martiTurnedToSteps" }, { "goTo": ["@marti", "beach.steps_bottom"], "route": "via", "via": ["town.awning", "town.steps_top"] }],
          "exits": []
        },
        "detour_square": {
          "textKey": "sl.blocked_road.detour_square",
          "onEnter": [{ "fact": "martiDetoured" }, { "goTo": ["@marti", "town.tea_shop"], "route": "shortest" }],
          "exits": []
        },
        "turn_home": {
          "textKey": "sl.blocked_road.turn_home",
          "onEnter": [{ "fact": "martiWentHome" }, { "goTo": ["@marti", "flat.study"] }],
          "exits": []
        }
      }
    },

