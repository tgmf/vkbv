{
  "note": "Small state machines. A storylet activates when 'trigger' first holds (once: true = never re-activates). Exits: choice (actor softmaxes score/T over exits plus staying, stayScore default 0), hazard (perMille per tick, plus terms), auto (fires as soon as its gate holds). onEnter runs consequences. Roles bind at activation.",
  "storylets": [
    {
      "id": "door_lure", "required": true, "once": true,
      "roles": { "marti": { "cat": "marti" } },
      "trigger": { "at": "@marti", "region": "flat" },
      "start": "home",
      "states": {
        "home": {
          "exits": [
            { "to": "at_door", "kind": "choice", "actor": "@marti",
              "gate": { "power": "lure", "near": "@marti", "m": 25 },
              "score": { "base": 1, "terms": [{ "primeCount": "marti", "add": 2 }, { "gauge": "@marti.questionItch", "per": 300, "add": 1 }] } }
          ]
        },
        "at_door": {
          "textKey": "sl.door_lure.at_door",
          "onEnter": [{ "goTo": ["@marti", "flat.door"] }, { "fact": "martiAtDoor" }],
          "stayScore": 1,
          "exits": [
            { "to": "out", "kind": "choice", "actor": "@marti",
              "score": { "base": -3, "terms": [
                { "primeCount": "marti", "add": 2 },
                { "if": { "power": "lure", "near": "@marti", "m": 25 }, "add": 3 },
                { "if": { "weather": "rain" }, "add": -1 },
                { "gauge": "@marti.fearOfWater", "per": 250, "add": -1, "if": { "weather": "rain" } }
              ] } },
            { "to": "back_inside", "kind": "choice", "actor": "@marti",
              "score": { "base": 0, "terms": [
                { "gauge": "@marti.fearOfWater", "per": 300, "add": 1 },
                { "if": { "not": { "power": "lure", "near": "@marti", "m": 25 } }, "add": 2 }
              ] } }
          ]
        },
        "back_inside": {
          "textKey": "sl.door_lure.back_inside",
          "onEnter": [{ "fact": "martiTurnedBack" }, { "goTo": ["@marti", "flat.study"] }],
          "exits": [{ "to": "home", "kind": "hazard", "perMille": 100 }]
        },
        "out": {
          "textKey": "sl.door_lure.out",
          "onEnter": [{ "fact": "martiOut" }, { "goTo": ["@marti", "town.tea_shop"], "route": "shortest", "note": "his usual way: down the lane, through the roadworks" }],
          "exits": []
        }
      }
    },

    {
      "id": "roadworks_day", "required": true, "once": true,
      "roles": { "crew": { "roleTag": "crew", "bind": "all" }, "foreman": { "roleTag": "foreman" } },
      "trigger": { "clock": ["05:40", "23:59"] },
      "start": "not_started",
      "states": {
        "not_started": {
          "exits": [{ "to": "working", "kind": "hazard", "perMille": 40, "gate": { "clock": ["06:00", "08:00"] } }]
        },
        "working": {
          "textKey": "sl.roadworks_day.working",
          "onEnter": [{ "fact": "crewArrived" }, { "goTo": ["@crew", "town.roadworks"] }],
          "exits": [
            { "to": "on_break", "kind": "choice", "actor": "@foreman",
              "score": { "base": -5, "terms": [
                { "if": { "flag": "teaBreakCalled", "at": "@foreman" }, "add": 8 },
                { "if": { "clock": ["09:00", "09:40"] }, "add": 4 },
                { "gauge": "@foreman.sunbeamTax", "per": 300, "add": 1 }
              ] } },
            { "to": "finished", "kind": "auto", "gate": { "counter": "roadwork", "gte": 1740 } },
            { "to": "abandoned", "kind": "auto", "gate": { "all": [{ "weather": "rain" }, { "counter": "roadwork", "lt": 1740 }] } }
          ]
        },
        "on_break": {
          "textKey": "sl.roadworks_day.on_break",
          "onEnter": [{ "startActivity": ["@crew", "tea_break"] }],
          "exits": [
            { "to": "working", "kind": "hazard", "perMille": 60 },
            { "to": "abandoned", "kind": "auto", "gate": { "all": [{ "weather": "rain" }, { "counter": "roadwork", "lt": 1740 }] } }
          ]
        },
        "finished": {
          "textKey": "sl.roadworks_day.finished",
          "onEnter": [{ "fact": "roadDone" }, { "goTo": ["@crew", "town.crew_shed"] }],
          "exits": []
        },
        "abandoned": {
          "textKey": "sl.roadworks_day.abandoned",
          "onEnter": [{ "fact": "roadBlocked" }, { "emit": "barrier.fell", "at": "town.roadworks" }, { "goTo": ["@crew", "town.crew_shed"] }],
          "exits": []
        }
      }
    },

    {
      "id": "blocked_road", "required": true, "once": true,
